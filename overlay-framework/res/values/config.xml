<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Telecom must pick MODE_IN_COMMUNICATION before dialing, or the HAL starts a modem voice call that grabs the mic -->
	<bool name="config_use_voip_mode_for_ims">true</bool>
	<!-- Cell identity with location off, for P-Access-Network-Info; some IMS cores answer 500 without it -->
	<string-array name="config_serviceStateLocationAllowedPackages">
		<item>com.android.phone</item>
		<item>me.phh.ims</item>
	</string-array>
</resources>
